# Required for production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
# Local default is SQLite. Use a managed PostgreSQL URL in production.
DATABASE_URL=sqlite:///social_platform.db
FLASK_DEBUG=1
COOKIE_SECURE=false
# Optional comma-separated allowed origins for Socket.IO, e.g. https://hdm.example.com
RATELIMIT_STORAGE_URI=memory://
SOCKETIO_ALLOWED_ORIGINS=
# Optional username allowed to access Flask-Admin
ADMIN_USERNAME=
PORT=5000
